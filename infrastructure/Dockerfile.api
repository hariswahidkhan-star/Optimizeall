FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/src

WORKDIR /app

COPY apps/api/pyproject.toml ./pyproject.toml
RUN pip install --no-cache-dir \
      "fastapi>=0.115" "uvicorn[standard]>=0.32" "sqlalchemy[asyncio]>=2.0.36" \
      "asyncpg>=0.30" "alembic>=1.14" "pydantic-settings>=2.6" "pyjwt[crypto]>=2.10"

COPY apps/api/src ./src
COPY apps/api/alembic ./alembic
COPY apps/api/alembic.ini ./alembic.ini

# Runs unprivileged: nothing here needs root, so nothing here gets it.
RUN useradd --create-home --uid 10001 pciai && chown -R pciai:pciai /app
USER pciai

EXPOSE 8080
CMD ["python", "-m", "uvicorn", "pciai.main:app", "--host", "0.0.0.0", "--port", "8080"]
