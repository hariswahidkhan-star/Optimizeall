# Copy to .env for local development. Never commit a real secret.
PCIAI_ENVIRONMENT=local

# The application role. Owns nothing, so row-level security applies to it.
PCIAI_DATABASE_URL=postgresql+asyncpg://pciai_app:pciai_app@127.0.0.1:5432/pciai

# The migration and operations role. Owns the tables and may bypass RLS.
PCIAI_MIGRATION_DATABASE_URL=postgresql+asyncpg://pciai_owner:pciai_owner@127.0.0.1:5432/pciai

# Dev token issuer. Refused outside local/test; startup fails if left at the
# default in staging or production.
PCIAI_DEV_JWT_SECRET=dev-only-not-a-secret
PCIAI_DEV_JWT_ISSUER=pciai-dev

# Required in staging and production; unused locally.
# PCIAI_OIDC_ISSUER=
# PCIAI_OIDC_AUDIENCE=
# PCIAI_OIDC_JWKS_URL=

PCIAI_SQL_ECHO=false
